# Browser CDP (Auto-detected & auto-started by llm-harvester on port 9222. Only set for remote/cloud CDP)
# LLM_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>

# 9Router Configuration
NINEROUTER_URL=http://localhost:20128
NINEROUTER_API_KEY=sk_9router
# Password if your 9Router dashboard is password-protected
NINEROUTER_PASSWORD=
LLM_SHIM_BASE_URL=http://localhost:8787/v1

# Optional: Auto-upload harvested sessions to remote VPS running the shim (Setup B)
# LLM_REMOTE_SYNC=user@vps:/opt/llm-harvester/harvest/sessions.jsonl

# Optional: Proxy pool (host:port:user:pass, newline or comma separated)
# LLM_PROXIES=

# Optional: IMAP catch-all / Gmail verification — used ONLY by TokenMix & Grok.
# (TokenMix rejects disposable domains; other targets use mail.tm.)
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=your-16-char-app-password
# IMAP_ENABLED=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# EMAIL_DOMAIN=your-catch-all-domain.com

# Optional (full automation): Cloudflare API token to set up the catch-all rule
# Needs Zone: Email Routing Edit + DNS Edit. Zone id auto-detected if empty.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
